# Copy to docker/server/.env and fill in. The .env file holds secrets and is never committed.
#
# Biot identifies people through an OIDC provider the operator already runs; it is not an identity
# provider itself. Point these at that provider. The issuer must be HTTPS.
BIOT_OIDC_ISSUER=https://id.example.com
BIOT_OIDC_CLIENT_ID=biot-server
BIOT_OIDC_CLIENT_SECRET=

# Phoenix's signing and encryption key: mise exec -- mix phx.gen.secret
SECRET_KEY_BASE=

# The control hostname. The provider must allow the redirect https://<PHX_HOST>/login/callback,
# and an edge proxy must serve that name and forward it to this stack's HTTP port.
PHX_HOST=localhost

# The suffix under which preview hostnames are created. PHX_HOST must not be under it.
BIOT_SERVER_PUBLICATION_DOMAIN=preview.localhost

# Host-side ports. The container-side ports are fixed at 4000, 2222, and 4443.
BIOT_HTTP_PORT=4000
BIOT_SSH_HOST_PORT=2222
BIOT_CONTROL_HOST_PORT=4443
