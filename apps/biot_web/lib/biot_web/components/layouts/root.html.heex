<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#082a2f" />
    <link
      rel="preload"
      href="/fonts/space-mono-regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" href="/fonts/space-mono-bold.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="biot" suffix="" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const key = "biot:theme";
        const systemTheme = () => window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          const selected = ["dark", "light", "system"].includes(theme) ? theme : "system";
          if (selected === "system") localStorage.removeItem(key);
          else localStorage.setItem(key, selected);
          const resolved = selected === "system" ? systemTheme() : selected;
          document.documentElement.dataset.theme = resolved;
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content",
            resolved === "dark" ? "#082a2f" : "#eef5f0"
          );
          document.documentElement.dataset.themeSource = selected;
          window.dispatchEvent(new CustomEvent("biot-theme-changed", {detail: {theme: selected}}));
        };
        setTheme(localStorage.getItem(key) || "system");
        window.addEventListener("storage", (event) => event.key === key && setTheme(event.newValue || "system"));
        window.addEventListener("phx:biot-theme", (event) => setTheme(event.detail.theme));

        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
          if (document.documentElement.dataset.themeSource === "system") {
            setTheme("system");
          }
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
