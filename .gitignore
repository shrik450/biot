# Elixir and Mix
/_build/
/deps/
.elixir_ls/
*.ez
*.beam
*.dump

# Phoenix assets
/apps/*/assets/node_modules/
/apps/*/priv/static/assets/
/apps/*/priv/static/cache_manifest.json

# phx.digest output: a content-hashed copy of a tracked file in priv/static, its .gz, and the
# original's .gz. The release regenerates and verifies them, so they are not tracked: a committed
# digest could disagree with its source, and the set grows on every asset change.
/apps/*/priv/static/**/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*
/apps/*/priv/static/**/*.gz

# Local databases
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Go
cli/biot

# mise local state
.mise/
.mise.local.toml
.mise.local.*

# Nix build outputs
/result
/result-*

# ExUnit tmp_dir output
/apps/*/tmp/
.work/
